@using DominioObligatorio
@using Microsoft.AspNetCore.Http

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema Incidentes</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebApplication1.styles.css" asp-append-version="true" />
</head>
<body>

    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">

            <div class="container-fluid">

                

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <!-- Menú izquierda -->
                    <ul class="navbar-nav">

                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>
                        @if (Context.Session.GetString("Rol") == Rol.OPERADOR.ToString())
                        {
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                            asp-controller="Activos"
                            asp-action="Index">
                            Mis Activos
                            </a>
                        </li>
                        }
                        
                        <!-- Solo Admin -->
                        @if (Context.Session.GetString("Rol") == Rol.ADMIN.ToString())
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Personas" asp-action="Index">Personas</a>
                            </li>
                            <li class="nav-item">
                               <a class="nav-link text-dark" asp-controller="Incidentes" asp-action="Index">Incidentes</a>
                            </li>
                        }
                    </ul>

                    <!-- Menú derecha -->
                    <ul class="navbar-nav">

                        @if (Context.Session.GetString("Rol") != null)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Personas"
                                   asp-action="Perfil">
                                    Ver Perfil
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Personas"
                                   asp-action="Logout">
                                    Salir
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Personas" asp-action="Registro">Registrarse</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark"
                                   asp-controller="Personas"
                                   asp-action="Login">
                                    Login
                                </a>
                            </li>
                        }

                    </ul>

                </div>

            </div>

        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-center text-dark py-1">
        <p class="m-0 lh-sm">Programación 2 - Obligatorio 2 - Sistema de Incidentes</p>
        <p class="m-0 lh-sm">Thiao Passadore - Rodrigo Sangorrín</p>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
