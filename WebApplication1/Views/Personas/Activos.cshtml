@{
    ViewData["Title"] = "Activos";
    Cuenta cuenta = ViewBag.Cuenta;
    List<Activo> activos = ViewBag.Activos;
}

<h1>Activos de la cuenta @cuenta.CodigoUsuario</h1>

<table class="table">
    <thead>
    <tr>
        <th>Código</th>
        <th>Nombre</th>
        <th>Tipo</th>
        <th>Criticidad</th>
        <th>Backup</th>
    </tr>
    </thead>
    <tbody>
    @foreach (Activo a in activos)
    {
        //Para Rider
        string backup = a.TieneBackup ? "Sí" : "No";
        <tr>
            <td>@a.Codigo</td>
            <td>@a.Nombre</td>
            <td>@a.TipoActivo</td>
            <td>@a.Criticidad</td>
            <td>@backup</td>
        </tr>
    }
    </tbody>
</table>