@{
    ViewData["Title"] = "Activos";
    Cuenta cuenta = ViewBag.Cuenta;
    List<Activo> activos = ViewBag.Activos;
}

<h1>Activos de la cuenta @cuenta.CodigoUsuario</h1>

@if (ViewBag.Exito != null)
{
    <div class="alert alert-success">@ViewBag.Exito</div>
}
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}
<a asp-action="CrearActivo" asp-route-codigoCuenta="@cuenta.CodigoUsuario" class="btn btn-primary mb-3">Crear activo</a>
@if (activos == null || activos.Count == 0)
{
    <div class="alert alert-warning">Esta cuenta no tiene activos.</div>
}
else
{
    
    <table class="table table-striped table-hover align-middle">
        <thead>
    <tr>
        <th>Código</th>
        <th>Nombre</th>
        <th>Tipo</th>
        <th>Criticidad</th>
        <th>Backup</th>
        <th></th>
    </tr>
    </thead>
    <tbody>
    @foreach (Activo a in activos)
    {
        //Para Rider
        string backup = a.TieneBackup ? "Sí" : "No";
        <tr>
            <td>@a.Codigo</td>
            <td>@a.Nombre</td>
            <td>@a.TipoActivo</td>
            <td>@a.Criticidad</td>
            <td>@backup</td>
            <td>
                <form method="post" asp-action="Desasociar">
                    <input type="hidden" name="codigoCuenta" value="@cuenta.CodigoUsuario" />
                    <input type="hidden" name="codigoActivo" value="@a.Codigo" />
                    <button type="submit" class="btn btn-danger btn-sm">Desasociar</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
}
