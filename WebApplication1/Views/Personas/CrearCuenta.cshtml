@{
    ViewData["Title"] = "Crear cuenta";
}

<div class="card shadow-sm">
    <div class="card-body">
        <h1>Crear Cuenta</h1>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <form method="post" asp-action="CrearCuenta">
            <input type="hidden" name="cedula" value="@ViewBag.Cedula" />

            <div class="mb-3 form-check">
                <input type="checkbox" name="mfa" value="true" class="form-check-input" id="mfa" />
                <label class="form-check-label" for="mfa">MFA habilitado</label>
            </div>

            <div class="mb-3">
                <label>Fecha del último cambio de contraseña</label>
                <input type="date" name="fecha" class="form-control" />
            </div>

            <button type="submit" class="btn btn-primary">Crear cuenta</button>
            <a class="btn btn-secondary" href="javascript:history.back()">Volver</a>
        </form>
    </div>
</div>