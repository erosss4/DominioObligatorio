@{
    ViewData["Title"] = "Login";
}

<h1>Login</h1>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">
        @ViewBag.Error
    </div>
}

<form action="/Personas/Login" method="post">

    <input type="email"
           name="email"
           placeholder="Ingrese email" />

    <input type="password"
           name="pass"
           placeholder="Ingrese contraseña" />

    <input type="submit"
           value="Login" />

</form>
