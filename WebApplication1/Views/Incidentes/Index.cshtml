@{
    ViewData["Title"] = "Incidentes";
    List<Incidente> incidentes = ViewBag.Incidentes;
}

<h1>Incidentes</h1>

@if (incidentes == null || incidentes.Count == 0)
{
    <div class ="alert alert-warning">No hay incidentes</div>
}
else
{
    <table class="table table-striped">
        <thead>
        <tr>
            <th>Id</th>
            <th>Fecha</th>
            <th>Estado</th>
            <th>Codigo Activo</th>
            <th>Severidad</th>
        </tr>
        </thead>
        <tbody>
        @foreach (Incidente i in incidentes)
        {
            <tr>
            <td>@i.Id</td>
            <td>@i.FechaReportado.ToShortDateString()</td>
            <td>@i.Estado</td>
            <td>@i.Activo.Codigo</td>
            <td>@i.CalcularSeveridad()</td>
            </tr>
        }
        </tbody>
    </table>
}